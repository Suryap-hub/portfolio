# Copy this file to .env and fill in your values. Never commit .env.

# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Model to use. Check https://console.groq.com/docs/models if this one is retired.
GROQ_MODEL=openai/gpt-oss-20b
GROQ_REASONING_EFFORT=low

# Comma-separated list of frontend URLs allowed to call this API.
# Add your Vercel URL here after deploying, e.g. https://surya.vercel.app
ALLOWED_ORIGINS=http://localhost:3000

# Abuse protection
RATE_LIMIT_PER_HOUR=30
MAX_MESSAGE_CHARS=500
MAX_HISTORY_MESSAGES=12
MAX_OUTPUT_TOKENS=700
