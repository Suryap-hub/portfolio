# Copy to .env.local.
#
# Local development: leave NEXT_PUBLIC_API_URL empty. The browser calls this
# site's /api/..., and Next.js forwards it to BACKEND_URL.
NEXT_PUBLIC_API_URL=
BACKEND_URL=http://localhost:8000
#
# Production (Vercel): set NEXT_PUBLIC_API_URL to your Render URL, e.g.
# NEXT_PUBLIC_API_URL=https://surya-portfolio-api.onrender.com
